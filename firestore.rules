rules_version = '2';

// Devler Ligi Kuponu: kim neyi okuyup yazabilir
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Yönetici: kullanıcı adı "yonetici" olan hesap (oyuncu değildir)
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'yonetici@oyuncu.devlerligi.example.com';
    }

    function playerPath() { return /databases/$(database)/documents/players/$(request.auth.uid); }
    function isActivePlayer() {
      return signedIn() && exists(playerPath()) && get(playerPath()).data.get('removed', false) != true;
    }

    // Oyuncu kaydı: herkes kendi kaydını bir kez açar, sonrasını yalnız yönetici değiştirir
    match /players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && !isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'uname', 'joinedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 20
        && request.resource.data.uname == request.auth.token.email.split('@')[0]
        && request.resource.data.joinedAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Kuponlar: oyuncu yalnız kendi adına, sunucu saatiyle kupon ekler; değiştiremez, silemez
    match /coupons/{cid} {
      allow read: if signedIn();
      allow create: if isActivePlayer()
        && request.resource.data.keys().hasOnly(['uid', 'at', 'round', 'stake', 'sel'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.round is string
        && request.resource.data.stake is number
        && request.resource.data.stake >= 1
        && request.resource.data.sel is list
        && request.resource.data.sel.size() >= 1
        && request.resource.data.sel.size() <= 40;
      allow update, delete: if isAdmin();
    }

    // Yöneticinin elle girdiği oran, sonuç ve hafta değişiklikleri
    match /overrides/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Kasa düzeltmeleri
    match /adjust/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Şifre sıfırlama istekleri (GitHub Action işler ve siler)
    match /resets/{uid} {
      allow read, write: if isAdmin();
    }
  }
}
